/* Cyber: dark box with a bright accent outline, accent text, inverted selection */
window { location: center; anchor: center; width: 42em; border: 2px; border-color: @primary; border-radius: 10px; background-color: @background; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 0.4em; background-image: none; background-color: transparent; }
inputbar { margin: 0 0 0.4em 0; padding: 0.2em 0.8em; border-radius: 8px; border: 1px; border-color: @primary; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "  "; padding: 0.9em 0.2em 0 0.3em; text-color: @primary; }
entry { text-color: @primary; placeholder-color: @primary-container; }
listview { lines: 8; columns: 1; spacing: 0.2em; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.5em 0.8em; border-radius: 8px; text-color: @primary; }
element selected.normal { background-color: @primary; text-color: @on-primary; border-radius: 8px; }
element-icon { size: 2em; }
