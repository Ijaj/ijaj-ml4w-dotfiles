/* Sumi: nearly empty. Floating line of ink: one thin rule under the input, selected entry gets the stamp */
* { font: "Noto Serif CJK JP 12"; }
window { location: center; anchor: center; width: 34em; border: 1px; border-color: @outline-variant; border-radius: 2px; background-color: @surface; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 1.2em 1.4em; background-image: url("~/.local/share/ml4w-custom/textures/paper-wide.svg", both); background-color: transparent; }
inputbar { margin: 0 0 0.8em 0; padding: 0 0 0.3em 0; border-radius: 0; border: 0 0 1px 0; border-color: @outline; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "墨"; padding: 0.7em 0.6em 0 0; text-color: @tertiary; }
entry { padding: 0.7em 0.2em; text-color: @on-surface; placeholder-color: @outline; }
listview { lines: 7; columns: 1; spacing: 0.2em; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.45em 0.8em; border-radius: 2px; text-color: @on-surface-variant; }
element selected.normal { background-color: @tertiary; text-color: @on-tertiary; border-radius: 2px; }
element-icon { size: 1.6em; }
