/* Minimal: no box, just text on the wallpaper with an accent bar on the selection */
window { location: center; anchor: center; width: 34em; border: 0; border-radius: 0; background-color: @surface; padding: 1.2em; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0.6em; background-image: none; background-color: transparent; }
inputbar { margin: 0; padding: 0; border-radius: 0; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: ""; padding: 0; }
entry { font: "Fira Sans 17"; padding: 0.2em 0; placeholder: "type to search"; }
listview { lines: 6; columns: 1; spacing: 0; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.45em 0.8em; border-radius: 0; }
element selected.normal { background-color: transparent; text-color: @primary; border: 0 0 0 3px; border-color: @primary; border-radius: 0; }
element-icon { size: 1.6em; }
