/* Paper: calm, low contrast, soft rounded rows */
window { location: center; anchor: center; width: 40em; border: 1px; border-color: @outline-variant; border-radius: 14px; background-color: alpha(@surface-container-low, 0.82); }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0.4em; padding: 0.8em; background-image: none; background-color: transparent; }
inputbar { margin: 0; padding: 0.2em 0.8em; border-radius: 10px; background-color: @surface-container-high; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { padding: 0.9em 0.2em 0 0.3em; text-color: @on-surface-variant; }
listview { lines: 7; columns: 1; spacing: 0.15em; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.55em 0.8em; border-radius: 10px; }
element selected.normal { background-color: @primary-container; text-color: @on-primary-container; border-radius: 10px; }
element-icon { size: 2em; }
