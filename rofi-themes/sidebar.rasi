/* Sidebar: tall panel on the left edge */
window { location: west; anchor: west; x-offset: 12px; width: 24em; height: 92%; border: @border-width; border-color: @primary; border-radius: 18px; background-color: @surface; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 0.6em; background-image: none; background-color: transparent; }
inputbar { margin: 0 0 0.6em 0; padding: 0.2em 0.5em; border-radius: 12px; background-color: @surface-container-high; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { padding: 0.9em 0.2em 0 0.4em; text-color: @primary; }
listview { lines: 14; columns: 1; spacing: 0.15em; fixed-height: true; padding: 0; background-color: transparent; }
element { padding: 0.55em 0.7em; border-radius: 10px; }
element selected.normal { background-color: @primary-container; text-color: @on-primary-container; border-radius: 10px; }
element-icon { size: 2em; }
