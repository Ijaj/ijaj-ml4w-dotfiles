/* Terminal: monospace, square, no icons, bright block on the selected line */
* { font: "FiraCode Nerd Font 11"; }
window { location: center; anchor: center; width: 46em; border: 2px; border-color: @primary; border-radius: 0; background-color: @surface; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; background-image: none; background-color: transparent; }
inputbar { margin: 0; padding: 0.3em 0.6em; border-radius: 0; border: 0 0 2px 0; border-color: @primary; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "$"; padding: 0.7em 0.4em 0 0; text-color: @primary; }
entry { padding: 0.6em 0.2em; placeholder: "_"; }
listview { lines: 10; columns: 1; spacing: 0; padding: 0.3em 0; fixed-height: false; background-color: transparent; }
element { padding: 0.25em 0.8em; border-radius: 0; }
element selected.normal { background-color: @primary; text-color: @on-primary; border-radius: 0; }
element-icon { size: 0em; }
