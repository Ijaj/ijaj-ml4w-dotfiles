/* Blueprint: drafting sheet. Dashed frame, title-block input row, bracketed numbering, mono type */
* { font: "FiraCode Nerd Font Mono 11"; }
window { location: center; anchor: center; width: 42em; border: 1px; border-color: @primary; border-radius: 0; background-color: alpha(@surface, 0.82); }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 0.6em; background-image: url("~/.local/share/ml4w-custom/textures/grid-wide.svg", both); background-color: transparent; }
inputbar { margin: 0 0 0.6em 0; padding: 0.2em 0.6em; border-radius: 0; border: 1px 0 1px 0; border-color: @primary; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "REV.A ▸ FIND"; padding: 0.8em 0.6em 0 0; text-color: @primary; }
entry { padding: 0.7em 0.2em; text-color: @on-surface; placeholder-color: @outline; }
listview { lines: 9; columns: 1; spacing: 0; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.4em 0.7em; border-radius: 0; border: 0 0 1px 0; border-color: @outline-variant; }
element selected.normal { background-color: transparent; text-color: @primary; border-radius: 0; border: 1px; border-color: @primary; }
element-icon { size: 1.6em; }
