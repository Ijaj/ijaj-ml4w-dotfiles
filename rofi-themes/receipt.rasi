/* Receipt: narrow thermal printout on inverse-surface paper, dotted rules, mono caps */
* { font: "FiraCode Nerd Font Mono 11"; }
window { location: center; anchor: center; width: 26em; border: 1px; border-color: @inverse-on-surface; border-radius: 0; background-color: @inverse-surface; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 0.8em; background-image: none; background-color: transparent; }
inputbar { margin: 0 0 0.6em 0; padding: 0 0 0.4em 0; border-radius: 0; border: 0 0 2px 0; border-color: @inverse-on-surface; background-color: transparent; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "ITEM»"; padding: 0.8em 0.4em 0 0; text-color: @inverse-on-surface; }
entry { padding: 0.7em 0.2em; text-color: @inverse-on-surface; placeholder-color: @outline; }
listview { lines: 10; columns: 1; spacing: 0; padding: 0; fixed-height: false; background-color: transparent; }
element { padding: 0.3em 0.2em; border-radius: 0; border: 0 0 1px 0; border-color: @outline-variant; text-color: @inverse-on-surface; background-color: transparent; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @inverse-on-surface; }
element selected.normal { background-color: @inverse-on-surface; text-color: @inverse-surface; border-radius: 0; }
element-icon { size: 1.4em; }
