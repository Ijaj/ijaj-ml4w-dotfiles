/* Transit: station-sign launcher. Header band in the line color, each entry has a stop dot, selected stop is the interchange */
* { font: "Fira Sans SemiBold 12"; }
window { location: center; anchor: center; width: 38em; border: 3px; border-color: @primary; border-radius: 14px; background-color: @surface; }
mainbox { orientation: vertical; children: [ "inputbar", "listview" ]; spacing: 0; padding: 0; background-image: none; background-color: transparent; }
inputbar { margin: 0; padding: 0.3em 1em; border-radius: 11px 11px 0 0; border: 0; background-color: @primary; children: [ "textbox-prompt-colon", "entry" ]; }
textbox-prompt-colon { str: "●━━"; padding: 0.8em 0.5em 0 0; text-color: @on-primary; }
entry { padding: 0.7em 0.2em; text-color: @on-primary; placeholder-color: @on-primary; }
listview { lines: 8; columns: 1; spacing: 0; padding: 0.6em 0.8em; fixed-height: false; background-color: transparent; }
element { padding: 0.45em 0.8em 0.45em 1em; border-radius: 0; border: 0 0 0 4px; border-color: @primary; }
element selected.normal { background-color: @surface-container-high; text-color: @tertiary; border-radius: 0; border: 0 0 0 10px; border-color: @tertiary; }
element-icon { size: 1.7em; }
