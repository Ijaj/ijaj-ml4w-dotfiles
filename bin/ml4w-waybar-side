#!/usr/bin/env python3
"""Move every Waybar theme to one screen edge.

  ml4w-waybar-side              pick (rofi menu, or fzf with --tty)
  ml4w-waybar-side top|bottom|left|right
  ml4w-waybar-side default      remove the overrides (each theme's own position)
  ml4w-waybar-side current | refresh

Uses ML4W's own hooks: a theme folder may hold `config-custom` and the style
folder `style-custom.css`, and ML4W's launch.sh prefers them over `config` and
`style.css`. Nothing of ML4W's is edited; the generated files carry a marker
and are the only ones this tool ever deletes.
"""
import os, re, subprocess, sys

HOME = os.path.expanduser("~")
THEMES = f"{HOME}/.config/waybar/themes"
STATE = f"{HOME}/.config/ml4w/settings/waybar-side"
MARK = "generated by ml4w-waybar-side"
SIDES = ("top", "bottom", "left", "right")
INNER = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}

# modules that are too wide for a vertical bar
VERT_DROP = ["hyprland/window", "wlr/taskbar", "group/quicklinks", "custom/updates",
             "bluetooth", "group/hardware", "group/tools", "custom/ml4w-welcome"]


def read(p):
    with open(p) as f:
        return f.read()


def write_if_changed(p, text):
    if os.path.exists(p) and read(p) == text:
        return False
    with open(p, "w") as f:
        f.write(text)
    return True


def gen_config(src, side):
    lines = read(src).split("\n")
    # header = everything before the include / first modules-* line
    end = next((i for i, l in enumerate(lines) if '"include"' in l or '"modules-' in l), len(lines))
    head, rest = lines[:end], lines[end:]
    vals = {}
    keep = []
    for l in head:
        m = re.match(r'^\s*"(position|height|width|margin-top|margin-bottom|margin-left|margin-right)":\s*([^,\s]+),?\s*(//.*)?$', l)
        if m:
            vals[m.group(1)] = m.group(2).strip('"')
        else:
            keep.append(l)
    num = lambda k: int(vals.get(k, 0)) if str(vals.get(k, 0)).lstrip("-").isdigit() else 0
    mt, mb, ml, mr = (num(k) for k in ("margin-top", "margin-bottom", "margin-left", "margin-right"))
    e = max(mt, mb, ml, mr)
    if side == "top":
        mt, mb = max(mt, mb), 0
    elif side == "bottom":
        mt, mb = 0, max(mt, mb)
    elif side == "left":
        mt, mb, ml, mr = e, e, e, 0
    else:
        mt, mb, ml, mr = e, e, 0, e
    size = ['"width": 46,'] if side in ("left", "right") else [f'"height": {num("height") or 30},']
    block = [f'    "position": "{side}",'] + [f"    {s}" for s in size] + [
        f'    "margin-top": {mt},', f'    "margin-bottom": {mb},',
        f'    "margin-left": {ml},', f'    "margin-right": {mr},']
    # after the "layer" line (or at the top, after the opening brace)
    idx = next((i for i, l in enumerate(keep) if '"layer"' in l), 0)
    keep[idx + 1:idx + 1] = block
    text = "\n".join(keep + rest)
    if side in ("left", "right"):
        for name in VERT_DROP:
            text = re.sub(r'^[ \t]*"%s",?[ \t]*(//.*)?\n' % re.escape(name), "", text, flags=re.M)
        # no dangling comma before a closing bracket
        text = re.sub(r',(\s*(?://[^\n]*\n\s*)*)\]', r'\1]', text)
        text = text.rstrip().rstrip("}").rstrip().rstrip(",") + (
            ',\n    "clock": { "format": "{:%H\\n%M}", "tooltip-format": "{:%A %d %B %Y}" }\n}\n')
    return f"// {MARK}\n" + text


def gen_css(text, side, has_base):
    horizontal = side in ("top", "bottom")
    out = []
    for l in text.split("\n"):
        if has_base:
            l = l.replace("../style.css", "../style-side.css")
        if l.lstrip().startswith("window#waybar") and "{" in l:
            # the bar's own edge line goes on the side facing the screen
            l = re.sub(r"border-(top|bottom|left|right)", "border-" + INNER[side], l)
        elif not horizontal:
            l = re.sub(r"padding:\s*0\s+\d+px", "padding: 6px 0", l)
            l = re.sub(r"margin:\s*(\d+)px\s+(\d+)px(\s*[;}])", r"margin: \2px \1px\3", l)
            l = l.replace("border-bottom", "border-right").replace("border-left", "border-top")
        out.append(l)
    return f"/* {MARK} */\n" + "\n".join(out)


def variants(tdir):
    """Style folders ML4W may load for this theme."""
    v = [f"{tdir}/{d}" for d in sorted(os.listdir(tdir)) if os.path.isfile(f"{tdir}/{d}/style.css")]
    if os.path.isfile(f"{tdir}/style.css"):
        v.append(tdir)
    return v


def clean():
    n = 0
    for root, _, files in os.walk(THEMES):
        for f in files:
            if f in ("config-custom", "style-custom.css", "style-side.css"):
                p = os.path.join(root, f)
                if MARK in read(p)[:200]:
                    os.remove(p)
                    n += 1
    return n


def generate(side):
    changed = 0
    for t in sorted(os.listdir(THEMES)):
        tdir = f"{THEMES}/{t}"
        cfg = f"{tdir}/config"
        if not os.path.isfile(cfg):
            continue
        custom = f"{tdir}/config-custom"
        if os.path.exists(custom) and MARK not in read(custom)[:200]:
            continue  # the user's own override: leave alone
        changed += write_if_changed(custom, gen_config(cfg, side))
        base = f"{tdir}/style.css"
        has_base = os.path.isfile(base)
        vs = variants(tdir)
        subs = [v for v in vs if v != tdir]
        if has_base and subs:
            changed += write_if_changed(f"{tdir}/style-side.css", gen_css(read(base), side, False))
        for v in subs:
            changed += write_if_changed(f"{v}/style-custom.css", gen_css(read(f"{v}/style.css"), side, has_base))
        if tdir in vs:  # style.css sits in the theme folder itself
            changed += write_if_changed(f"{tdir}/style-custom.css", gen_css(read(base), side, False))
    return changed


def restart():
    subprocess.Popen(["setsid", "-f", f"{HOME}/.config/waybar/launch.sh"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)


def current():
    try:
        return read(STATE).strip() or "default"
    except OSError:
        return "default"


def apply(side, do_restart=True):
    if side == "default":
        n = clean()
    else:
        clean()  # drop stale files first so removed themes/variants do not linger
        n = generate(side)
    with open(STATE, "w") as f:
        f.write(side + "\n")
    if do_restart:
        restart()
    return n


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "pick"
    if arg == "current":
        print(current())
    elif arg == "refresh":
        s = current()
        if s != "default":
            # regenerate in place; report whether anything changed
            n = generate(s)
            print("changed" if n else "unchanged")
    elif arg == "pick":
        choices = ["default"] + list(SIDES)
        if "--tty" in sys.argv:
            cmd = ["fzf", "--prompt=side> ", "--height=30%", "--reverse"]
        else:
            cmd = ["rofi", "-dmenu", "-i", "-p", "Waybar side", "-theme-str", "window { width: 20em; }"]
        r = subprocess.run(cmd, input="\n".join(choices), capture_output=True, text=True)
        if r.stdout.strip():
            apply(r.stdout.strip())
            print(":: waybar side:", r.stdout.strip())
    elif arg in SIDES or arg == "default":
        apply(arg, "--no-restart" not in sys.argv)
        print(":: waybar side:", arg)
    else:
        print(__doc__)
        sys.exit(1)


main()
