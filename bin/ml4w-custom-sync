#!/usr/bin/env bash
# Re-applies this repo's customizations on top of the ML4W dotfiles.
# Safe to run any time: only touches what is missing or outdated.
repo="$(dirname "$(dirname "$(readlink -f "$0")")")"
backups="$HOME/.local/state/ml4w-custom/backups"

# Themes: copied, because the ML4W apps ignore symlinked dirs.
# "dir" kinds: each subfolder is copied whole. "file" kinds: each file is copied.
# format: <repo folder>:<destination>:<dir|file>
changed=0
active_waybar=$(cut -d';' -f1 "$HOME/.config/ml4w/settings/waybar-theme.sh" 2>/dev/null | tr -d '/')
waybar_changed=0
for entry in \
    "waybar-themes:.config/waybar/themes:dir" \
    "swaync-themes:.config/swaync/themes:dir" \
    "wlogout-themes:.config/wlogout/themes:dir" \
    "dock-themes:.config/nwg-dock-hyprland/themes:dir" \
    "ml4w-themes:.config/ml4w/themes:dir" \
    "hypr-decorations:.config/hypr/conf/decorations:file" \
    "hypr-windows:.config/hypr/conf/windows:file"; do
    IFS=: read -r from to kind <<<"$entry"
    [ -d "$repo/$from" ] && [ -d "$HOME/$to" ] || continue
    for item in "$repo/$from"/*; do
        [ -e "$item" ] || continue
        name=$(basename "$item")
        if ! diff -rq -x config-custom -x style-custom.css -x style-side.css "$item" "$HOME/$to/$name" >/dev/null 2>&1; then
            rm -rf "${HOME:?}/$to/$name"
            cp -r "$item" "$HOME/$to/$name"
            changed=1
            [ "$from" = waybar-themes ] && [ "$name" = "$active_waybar" ] && waybar_changed=1
            echo ":: synced $from/$name"
        fi
    done
done

# zshrc: symlinked, so edits in ~/.config/zshrc go straight into the repo.
# Files in zshrc/custom/ override the ML4W file with the same name.
if [ -d "$HOME/.config/zshrc" ]; then
    find "$repo/zshrc" -type f | while read -r src; do
        dst="$HOME/.config/zshrc/${src#"$repo/zshrc/"}"
        [ "$(readlink "$dst")" = "$src" ] && continue
        mkdir -p "$(dirname "$dst")"
        if [ -e "$dst" ] || [ -L "$dst" ]; then
            # Backups go outside ~/.config/zshrc, since ML4W sources every file there
            mkdir -p "$backups"
            mv "$dst" "$backups/$(basename "$dst").$(date +%Y%m%d%H%M%S)"
        fi
        ln -s "$src" "$dst"
        echo ":: linked $dst"
    done
fi


# Command-line tools: linked into ~/.local/bin
mkdir -p "$HOME/.local/bin"
for f in "$repo"/bin/*; do
    [ "$(readlink "$HOME/.local/bin/$(basename "$f")")" = "$f" ] || ln -sf "$f" "$HOME/.local/bin/$(basename "$f")"
done

# Rofi styles: config.rasi must import the style file the ml4w-rofi tool writes
rofi_style="$HOME/.config/ml4w/settings/rofi-theme.rasi"
[ -d "$HOME/.config/ml4w/settings" ] && [ -e "$rofi_style" ] || { [ -d "$HOME/.config/ml4w/settings" ] && echo '/* default ML4W look */' > "$rofi_style"; }
if [ -f "$HOME/.config/rofi/config.rasi" ] && ! grep -q 'rofi-theme.rasi' "$HOME/.config/rofi/config.rasi"; then
    printf '\n/* ---- Custom launcher style (ml4w-rofi) ---- */\n@import "~/.config/ml4w/settings/rofi-theme.rasi"\n' >> "$HOME/.config/rofi/config.rasi"
    echo ":: rofi config now imports rofi-theme.rasi"
fi

# Hyprland keybindings for the pickers: linked, and required from custom.lua
hypr="$HOME/.config/hypr"
if [ -d "$hypr" ]; then
    link="$hypr/ml4w-custom-binds.lua"
    if [ "$(readlink "$link")" != "$repo/hypr-custom/ml4w-custom-binds.lua" ]; then
        ln -sf "$repo/hypr-custom/ml4w-custom-binds.lua" "$link"
        echo ":: linked ml4w-custom-binds.lua"
    fi
    grep -qs 'ml4w-custom-binds' "$hypr/custom.lua" || {
        printf 'require("ml4w-custom-binds")\n' >> "$hypr/custom.lua"
        echo ":: custom.lua now loads ml4w-custom-binds"
    }
fi

# promptmap (Rust): build when missing or older than its source, then link into ~/.local/bin
pm="$repo/tools/promptmap"
if [ -d "$pm" ] && command -v cargo >/dev/null; then
    if [ ! -x "$pm/target/release/promptmap" ] || [ -n "$(find "$pm/src" "$pm/Cargo.toml" -newer "$pm/target/release/promptmap" -print -quit)" ]; then
        echo ":: building promptmap"
        (cd "$pm" && cargo build --release -q) || echo ":: promptmap build failed" >&2
    fi
    [ -x "$pm/target/release/promptmap" ] && ln -sf "$pm/target/release/promptmap" "$HOME/.local/bin/promptmap"
fi

# Textures (ml4w-texture): generated SVGs, linked next to the swaync/wlogout themes dirs so css can use url("../../textures/x.svg")
if command -v ml4w-texture >/dev/null; then
    ml4w-texture refresh >/dev/null 2>&1
    for d in swaync wlogout; do
        [ -d "$HOME/.config/$d" ] && [ "$(readlink "$HOME/.config/$d/textures")" != "$HOME/.local/share/ml4w-custom/textures" ] &&
            ln -sfn "$HOME/.local/share/ml4w-custom/textures" "$HOME/.config/$d/textures"
    done
fi

# live-accent.css: imported by the generated waybar styles; must exist (ml4w-live vital --bar fills it)
[ -d "$HOME/.config/ml4w/settings" ] && [ -e "$HOME/.config/ml4w/settings/live-accent.css" ] || { [ -d "$HOME/.config/ml4w/settings" ] && : > "$HOME/.config/ml4w/settings/live-accent.css"; }

# Waybar side override (ml4w-waybar-side): rebuild for new/updated themes
if command -v ml4w-waybar-side >/dev/null && [ "$(ml4w-waybar-side refresh)" = changed ]; then
    waybar_changed=1
fi

# Prompt: rebuild the active prompt (palette may have changed)
command -v ml4w-prompt >/dev/null && ml4w-prompt refresh >/dev/null 2>&1

# Restart waybar if the active theme is one of ours and it changed
if [ "$waybar_changed" = 1 ] && pgrep -x waybar >/dev/null; then
    setsid -f "$HOME/.config/waybar/launch.sh" >/dev/null 2>&1
fi
exit 0
