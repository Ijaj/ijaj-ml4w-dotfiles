#!/usr/bin/env python3
"""Procedural textures in the wallpaper palette (SVG), used as backgrounds by the Blueprint, Riso,
Sumi and Rackmount themes (rofi, notifications) and the `topo` rofi style.

  ml4w-texture refresh        regenerate from the current palette (run by the palette-change unit)
  ml4w-texture list           names and paths
  ml4w-texture <name>         print the file path of one texture (grid halftone paper brushed topo)

Files live in ~/.local/share/ml4w-custom/textures/. ml4w-custom-sync links that folder as
~/.config/swaync/textures and ~/.config/wlogout/textures so CSS can use url("../../textures/x.svg")."""
import math
import os
import random
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
OUT = f"{HOME}/.local/share/ml4w-custom/textures"
COLORS = f"{HOME}/.config/waybar/colors.css"
USERS = ("blueprint", "sumi", "rackmount", "riso")  # swaync themes that load a texture


def palette():
    pal = {}
    for l in open(COLORS):
        m = re.match(r"\s*@define-color ([a-z_0-9]+) (#[0-9a-fA-F]{6});", l)
        if m:
            pal[m.group(1)] = m.group(2)
    return pal


def svg(w, h, body, defs=""):
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" viewBox="0 0 {w} {h}">'
            f"<defs>{defs}</defs>{body}</svg>\n")


def grid(p, w=120, h=120):
    pat = (f'<pattern id="g" width="120" height="120" patternUnits="userSpaceOnUse">'
           f'<path d="M24 0V120M0 24H120M48 0V120M0 48H120M72 0V120M0 72H120M96 0V120M0 96H120" stroke="{p["outline_variant"]}" stroke-opacity=".28" stroke-width="1" fill="none"/>'
           f'<path d="M0 0H120V120" stroke="{p["primary"]}" stroke-opacity=".22" stroke-width="1" fill="none"/></pattern>')
    return svg(w, h, f'<rect width="{w}" height="{h}" fill="url(#g)"/>', pat)


def halftone(p, w=112, h=112):
    a = f'<pattern id="a" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(15)"><circle cx="7" cy="7" r="2.6" fill="{p["tertiary"]}" fill-opacity=".16"/></pattern>'
    b = f'<pattern id="b" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(75)"><circle cx="7" cy="7" r="2.2" fill="{p["secondary"]}" fill-opacity=".14"/></pattern>'
    return svg(w, h, f'<rect width="{w}" height="{h}" fill="url(#a)"/><rect width="{w}" height="{h}" fill="url(#b)"/>', a + b)


def paper(p, w=256, h=256):
    f = (f'<filter id="n" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="3" seed="7" result="t"/>'
         f'<feColorMatrix type="matrix" values="0 0 0 0 {int(p["on_surface"][1:3], 16) / 255:.3f}  0 0 0 0 {int(p["on_surface"][3:5], 16) / 255:.3f}  0 0 0 0 {int(p["on_surface"][5:7], 16) / 255:.3f}  0 0 0 .55 -.18"/></filter>')
    return svg(w, h, f'<rect width="{w}" height="{h}" filter="url(#n)" opacity=".5"/>', f)


def brushed(p, w=256, h=128):
    f = (f'<filter id="n" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".004 .9" numOctaves="2" seed="3"/>'
         f'<feColorMatrix type="matrix" values="0 0 0 0 {int(p["on_surface"][1:3], 16) / 255:.3f}  0 0 0 0 {int(p["on_surface"][3:5], 16) / 255:.3f}  0 0 0 0 {int(p["on_surface"][5:7], 16) / 255:.3f}  0 0 0 .7 -.25"/></filter>')
    return svg(w, h, f'<rect width="{w}" height="{h}" filter="url(#n)" opacity=".24"/>', f)


def topo(p):
    """Contour map of a sum-of-sines field (seeded by the palette, so a new wallpaper gives a new landscape)."""
    rnd = random.Random(p["primary"] + p["tertiary"])
    waves = [(rnd.uniform(.6, 1.7), rnd.uniform(.6, 1.7), rnd.uniform(0, 6.3), rnd.uniform(0, 6.3), rnd.uniform(.5, 1) * (1 if i % 2 else -1))
             for i in range(6)]
    W, H, N, M = 640, 400, 128, 80

    def f(x, y):
        return sum(amp * math.sin(kx * x * 12.6 / W + ph) * math.cos(ky * y * 12.6 / H + ph2) for kx, ky, ph, ph2, amp in waves) / len(waves)

    vals = [[f(i * W / N, j * H / M) for i in range(N + 1)] for j in range(M + 1)]
    lo, hi = min(map(min, vals)), max(map(max, vals))
    levels = [lo + (hi - lo) * k / 15 for k in range(1, 15)]
    paths = []
    for li, lv in enumerate(levels):
        segs = []
        for j in range(M):
            for i in range(N):
                v = (vals[j][i], vals[j][i + 1], vals[j + 1][i + 1], vals[j + 1][i])
                idx = sum((v[k] > lv) << k for k in range(4))
                if idx in (0, 15):
                    continue

                def lerp(a, b, ai, bi):
                    t = (lv - a) / (b - a) if b != a else .5
                    return (ai[0] + (bi[0] - ai[0]) * t, ai[1] + (bi[1] - ai[1]) * t)

                c = [(i, j), (i + 1, j), (i + 1, j + 1), (i, j + 1)]
                edges = {0: (0, 1), 1: (1, 2), 2: (2, 3), 3: (3, 0)}
                cross = []
                for e, (a, b) in edges.items():
                    if (v[a] > lv) != (v[b] > lv):
                        cross.append(lerp(v[a], v[b], c[a], c[b]))
                for k in range(0, len(cross) - 1, 2):
                    (x1, y1), (x2, y2) = cross[k], cross[k + 1]
                    segs.append(f"M{x1 * W / N:.1f} {y1 * H / M:.1f}L{x2 * W / N:.1f} {y2 * H / M:.1f}")
        major = li % 4 == 0
        col, op, sw = (p["primary"], .5, 1.4) if major else (p["outline_variant"], .42, .8)
        paths.append(f'<path d="{"".join(segs)}" stroke="{col}" stroke-opacity="{op}" stroke-width="{sw}" fill="none" stroke-linecap="round"/>')
    return svg(W, H, "".join(paths))


# "-wide" variants are one big image for rofi, which cannot tile backgrounds (used with scale "both")
GEN = {"grid": grid, "halftone": halftone, "paper": paper, "brushed": brushed, "topo": topo,
       "grid-wide": lambda p: grid(p, 800, 640), "halftone-wide": lambda p: halftone(p, 800, 640),
       "paper-wide": lambda p: paper(p, 800, 640), "brushed-wide": lambda p: brushed(p, 800, 640)}


def refresh():
    os.makedirs(OUT, exist_ok=True)
    p = palette()
    changed = False
    for name, fn in GEN.items():
        path = f"{OUT}/{name}.svg"
        text = fn(p)
        try:
            if open(path).read() == text:
                continue
        except OSError:
            pass
        open(path, "w").write(text)
        changed = True
    # swaync caches images: reload it when the active style uses a texture
    if changed:
        cur = subprocess.run(["ml4w-toast", "current"], capture_output=True, text=True).stdout.strip()
        if cur in USERS:
            subprocess.run(["swaync-client", "-rs"], capture_output=True)
    print("changed" if changed else "unchanged")


def main():
    a = sys.argv[1] if len(sys.argv) > 1 else "list"
    if a == "refresh":
        refresh()
    elif a == "list":
        for n in GEN:
            print(f"{n}\t{OUT}/{n}.svg")
    elif a in GEN:
        print(f"{OUT}/{a}.svg")
    else:
        print(__doc__)
        sys.exit(1)


main()
