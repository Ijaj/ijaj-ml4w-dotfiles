[Unit]
Description=Re-apply customizations when an ML4W update replaces its folders

[Path]
PathChanged=%h/.config/waybar/themes
PathChanged=%h/.config/zshrc
PathChanged=%h/.config/swaync/themes
PathChanged=%h/.config/wlogout/themes
PathChanged=%h/.config/nwg-dock-hyprland/themes
PathChanged=%h/.config/ml4w/themes
PathChanged=%h/.config/hypr/conf/decorations
PathChanged=%h/.config/hypr/conf/windows
PathChanged=%h/.config/zshrc/custom
# ML4W settings that edit the waybar config (generated side overrides copy it)
PathChanged=%h/.config/ml4w/settings/waybar_appmenu.sh
PathChanged=%h/.config/ml4w/settings/waybar_taskbar.sh
PathChanged=%h/.config/ml4w/settings/waybar_quicklinks.sh
PathChanged=%h/.config/ml4w/settings/waybar_window.sh
PathChanged=%h/.config/ml4w/settings/waybar_network.sh
PathChanged=%h/.config/ml4w/settings/waybar_systray.sh
Unit=ml4w-custom-sync.service

[Install]
WantedBy=default.target
