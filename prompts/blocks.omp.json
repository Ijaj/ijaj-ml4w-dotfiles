{
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "p:on_primary_container",
          "background": "p:primary_container",
          "trailing_diamond": "",
          "leading_diamond": ""
        },
        {
          "type": "text",
          "style": "plain",
          "template": " ",
          "foreground": "p:background"
        },
        {
          "type": "path",
          "style": "diamond",
          "template": " {{ .Path }} ",
          "foreground": "p:on_secondary_container",
          "background": "p:secondary_container",
          "properties": {
            "style": "folder",
            "max_depth": 4,
            "folder_separator_icon": "/"
          },
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "type": "text",
          "style": "plain",
          "template": " ",
          "foreground": "p:background"
        },
        {
          "type": "git",
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "foreground": "p:on_tertiary_container",
          "background": "p:tertiary_container",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " ",
            "untracked_modes": {
              "/": "no"
            }
          },
          "leading_diamond": "",
          "trailing_diamond": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "❯ ",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ]
}
