{
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "template": " {{ .UserName }} ",
          "foreground": "p:on_primary",
          "background": "p:primary"
        },
        {
          "type": "path",
          "style": "plain",
          "template": " {{ .Path }} ",
          "foreground": "p:on_secondary",
          "background": "p:secondary",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "foreground": "p:on_tertiary",
          "background": "p:tertiary",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " ",
            "untracked_modes": {
              "/": "no"
            }
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": "▌▌",
          "foreground": "p:tertiary"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "template": " {{ .FormattedMs }} ",
          "foreground": "p:on_surface",
          "background": "p:surface_container_high",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "template": " {{ .CurrentDate | date \"15:04\" }} ",
          "foreground": "p:on_secondary",
          "background": "p:secondary"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "template": "◐ ",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}