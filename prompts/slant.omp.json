{
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "template": " {{ .Path }} ",
          "foreground": "p:on_primary",
          "background": "p:primary",
          "properties": {
            "style": "folder",
            "max_depth": 4,
            "folder_separator_icon": "/"
          },
          "powerline_symbol": "",
          "leading_powerline_symbol": ""
        },
        {
          "type": "git",
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "foreground": "p:on_secondary",
          "background": "p:secondary",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " ",
            "untracked_modes": {
              "/": "no"
            }
          },
          "powerline_symbol": ""
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "template": " {{ .FormattedMs }} ",
          "foreground": "p:on_surface_variant",
          "background": "p:surface_container_high",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          },
          "powerline_symbol": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "❯ ",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ]
}
