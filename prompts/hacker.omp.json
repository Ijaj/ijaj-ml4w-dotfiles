{
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "template": "{{ .UserName }}@{{ .HostName }}",
          "foreground": "p:primary"
        },
        {
          "type": "text",
          "style": "plain",
          "template": ":",
          "foreground": "p:outline"
        },
        {
          "type": "path",
          "style": "plain",
          "template": "{{ .Path }}",
          "foreground": "p:secondary",
          "properties": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": " ({{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }})",
          "foreground": "p:tertiary",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " ",
            "untracked_modes": {
              "/": "no"
            }
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": "$",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ]
        }
      ]
    }
  ]
}
